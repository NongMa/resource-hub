generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String?
  image     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  files     File[]
  folders   Folder[]
  shares    Share[]

  @@map("users")
}

model Folder {
  id        String   @id @default(cuid())
  name      String
  parentId  String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  parent    Folder?  @relation("FolderToFolder", fields: [parentId], references: [id])
  children  Folder[] @relation("FolderToFolder")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  files     File[]

  @@map("folders")
}

model File {
  id          String   @id @default(cuid())
  name        String
  key         String   // 七牛云存储的 key
  size        Int
  mimeType    String
  folderId    String?
  userId      String
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  folder      Folder?  @relation(fields: [folderId], references: [id], onDelete: SetNull)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  shares      Share[]

  @@map("files")
}

model Share {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime?
  password  String?
  fileId    String
  userId    String
  createdAt DateTime @default(now())
  file      File     @relation(fields: [fileId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("shares")
}

/// 登录失败计数（按邮箱的不可逆标识存储）
model LoginAttempt {
  emailHash    String    @id
  failureCount Int       @default(0)
  windowStart  DateTime
  lockedUntil  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([updatedAt])
  @@map("login_attempts")
}

/// 图形验证码消费状态（tokenHash 为 captchaId 的不可逆标识）
model LoginCaptcha {
  tokenHash String    @id
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([expiresAt])
  @@map("login_captchas")
}
