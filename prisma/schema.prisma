generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String?
  image     String?
  sessionVersion Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  files     File[]
  folders   Folder[]
  shares    Share[]

  @@map("users")
}

model Folder {
  id        String   @id @default(cuid())
  name      String
  parentId  String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  parent    Folder?  @relation("FolderToFolder", fields: [parentId], references: [id])
  children  Folder[] @relation("FolderToFolder")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  files     File[]

  @@index([userId, parentId, name])
  @@map("folders")
}

model File {
  id          String   @id @default(cuid())
  name        String
  key         String   // 七牛云存储的 key
  size        Int
  mimeType    String
  folderId    String?
  userId      String
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  folder      Folder?  @relation(fields: [folderId], references: [id], onDelete: SetNull)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  shares      Share[]

  @@index([userId, folderId, createdAt(sort: Desc), id(sort: Desc)])
  @@map("files")
}

model Share {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime?
  password  String?
  fileId    String
  userId    String
  createdAt DateTime @default(now())
  file      File     @relation(fields: [fileId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([fileId])
  @@map("shares")
}

/// 登录失败计数（按邮箱的不可逆标识存储）
model LoginAttempt {
  emailHash    String    @id
  failureCount Int       @default(0)
  windowStart  DateTime
  lockedUntil  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([updatedAt])
  @@map("login_attempts")
}

// 邮箱验证码：按场景（register / reset）区分，摘要存储，一次性消费
model EmailVerificationCode {
  id        String    @id @default(cuid())
  emailHash String
  codeHash  String
  purpose   String    @default("register")
  expiresAt DateTime
  usedAt    DateTime?
  ipHash    String?
  createdAt DateTime  @default(now())

  @@index([emailHash, purpose, createdAt])
  @@index([expiresAt])
  @@map("email_verification_codes")
}

/// 引导邮件限流计数：按时间窗（60 秒 / 1 小时）原子累加，主键保证并发下不超发
model EmailNoticeCounter {
  keyType     String   // email / ip
  keyHash     String   // 带密钥 HMAC，不存明文
  windowStart DateTime
  count       Int      @default(0)
  createdAt   DateTime @default(now())

  @@id([keyType, keyHash, windowStart])
  @@index([windowStart])
  @@map("email_notice_counters")
}

// 图形验证码与一次性登录票据的消费状态（tokenHash 为令牌的不可逆标识）
model LoginCaptcha {
  tokenHash String    @id
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([expiresAt])
  @@map("login_captchas")
}
