# Supabase Database (PostgreSQL)
# 格式: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT].supabase.co:5432/postgres
DATABASE_URL="postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-generate-with-openssl-rand-base64-32"

# OAuth (可选 / Optional)
GITHUB_ID="your-github-oauth-app-id"
GITHUB_SECRET="your-github-oauth-app-secret"
GOOGLE_ID="your-google-oauth-app-id"
GOOGLE_SECRET="your-google-oauth-app-secret"

# 七牛云存储 / Qiniu Cloud Storage
QINIU_ACCESS_KEY="your-qiniu-access-key"
QINIU_SECRET_KEY="your-qiniu-secret-key"
QINIU_BUCKET="your-bucket-name"
QINIU_ZONE="zone华东z0 华北z1 华南z2 北美na0"
QINIU_DOMAIN="your-cdn-domain.e.gcdn.example.com"

# Vercel KV (可选用于会话存储 / Optional for session storage)
# KV_URL="your-vercel-kv-url"
# KV_REST_API_URL="your-vercel-kv-rest-api-url"
# KV_REST_API_TOKEN="your-vercel-kv-rest-api-token"
# KV_REST_API_READ_ONLY_TOKEN="your-vercel-kv-rest-api-read-only-token"
